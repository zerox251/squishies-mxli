generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  alias    String
  password String
  creadoEn DateTime @default(now())
}

model Squishy {
  id          Int         @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  costo       Float?
  stock       Int         @default(0)
  activo      Boolean     @default(true)
  creadoEn    DateTime    @default(now())
  ventas      VentaItem[]
  bazarItems  BazarItem[]
}

model Venta {
  id    Int         @id @default(autoincrement())
  fecha DateTime    @default(now())
  total Float
  canal String?
  notas String?
  items VentaItem[]
}

model VentaItem {
  id        Int      @id @default(autoincrement())
  ventaId   Int
  squishyId Int?
  nombre    String
  cantidad  Int
  precio    Float
  costo     Float?
  venta     Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  squishy   Squishy? @relation(fields: [squishyId], references: [id])
}

model Pedido {
  id           Int        @id @default(autoincrement())
  fecha        DateTime   @default(now())
  proveedorId  Int?
  proveedor    Proveedor? @relation(fields: [proveedorId], references: [id])
  total        Float
  montoPagado  Float      @default(0)
  status       String     @default("pendiente")
  notas        String?
  fechaPedido  DateTime?
  fechaLlegada DateTime?
  imagen       String?
  documento    String?
  gasto        Gasto?
  pagos        Pago[]
}

model Pago {
  id          Int      @id @default(autoincrement())
  monto       Float
  fecha       DateTime
  metodoPago  String?
  nota        String?
  pedidoId    Int
  creadoEn    DateTime @default(now())
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model Gasto {
  id        Int      @id @default(autoincrement())
  concepto  String
  categoria String   @default("operativo")
  fecha     DateTime @default(now())
  total     Float
  estado    String   @default("pendiente")
  notas     String?
  pedidoId  Int?     @unique
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id])
}

model Bazar {
  id     Int         @id @default(autoincrement())
  nombre String
  fecha  DateTime    @default(now())
  activo Boolean     @default(true)
  items  BazarItem[]
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  pais      String   @default("MX")
  contacto  String?
  telefono  String?
  email     String?
  notas     String?
  creadoEn  DateTime @default(now())
  pedidos   Pedido[]
}

model BazarItem {
  id               Int      @id @default(autoincrement())
  bazarId          Int
  squishyId        Int
  fecha            DateTime @default(now())
  cantidadEnviada  Int
  cantidadRegreso  Int      @default(0)
  bazar            Bazar   @relation(fields: [bazarId], references: [id], onDelete: Cascade)
  squishy          Squishy @relation(fields: [squishyId], references: [id])
}
